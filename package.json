{
  "name": "arkvoid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ARKVOID — original persistent cultivation fantasy open-world game.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:process": "node tools/assets/process.mjs",
    "assets:validate": "node tools/assets/validate.mjs",
    "check:cycles": "madge --circular --extensions ts src",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:cycles"
  },
  "dependencies": {
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/three": "^0.171.0",
    "eslint": "^9.17.0",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
